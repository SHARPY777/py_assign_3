            "value": "Bearer {{client_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admin/usage-summary/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "admin",
            "usage-summary",
            ""
          ]
        },
        "description": "A regular CLIENT company must be forbidden (403) from the admin usage dashboard."
      },
      "response": []
    },
    {
      "name": "11 - Usage Summary - Admin Token (200)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Log in as the demo admin created by `python manage.py seed_kb`",
              "// and store the token in the admin_token collection variable.",
              "pm.sendRequest({",
              "    url: pm.collectionVariables.get(\"base_url\") + \"/api/auth/login/\",",
              "    method: \"POST\",",
              "    header: { \"Content-Type\": \"application/json\" },",
              "    body: {",
              "        mode: \"raw\",",
              "        raw: JSON.stringify({ username: \"teamboard_admin\", password: \"adminpass123\" })",
              "    }",
              "}, function (err, res) {",
              "    if (err) {",
              "        console.error(\"Admin login pre-request failed: \" + err);",
              "        return;",
              "    }",
              "    pm.collectionVariables.set(\"admin_token\", res.json().access);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test(\"total_queries is a non-negative number\", function () {",
              "    pm.expect(data.total_queries).to.be.a(\"number\").and.at.least(0);",
              "});",
              "pm.test(\"active_companies is a non-negative number\", function () {",
              "    pm.expect(data.active_companies).to.be.a(\"number\").and.at.least(1);",
              "});",
              "pm.test(\"top_search_terms is a list of at most 5 terms\", function () {",
              "    pm.expect(data.top_search_terms).to.be.an(\"array\").with.length.of.at.most(5);",
              "});",
              "pm.test(\"top_search_terms entries have search_term and count\", function () {",
              "    data.top_search_terms.forEach(function (t) {",
              "        pm.expect(t).to.have.property(\"search_term\");",
              "        pm.expect(t).to.have.property(\"count\");",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admin/usage-summary/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "admin",
            "usage-summary",
            ""
          ]
        },
        "description": "An ADMIN company sees the platform-wide usage dashboard: total queries, distinct companies that queried, and the top 5 most-searched terms. The admin token is obtained automatically in the pre-request script by logging in as the demo admin (teamboard_admin / adminpass123) created by the seed command."
      },
      "response": []
    }
