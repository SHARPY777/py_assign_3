{
  "info": {
    "_postman_id": "b7e6a1c2-5d34-4f8a-9c1e-teamboard0001",
    "name": "TeamBoard API",
    "description": "TeamBoard - AI-powered Knowledge Base B2B API.\n\nRun the requests in order (1-11) against a freshly seeded database.\nBefore re-running the whole collection, reset the database with:\n\n    python manage.py flush --no-input && python manage.py seed_kb\n\nDemo admin account created by `python manage.py seed_kb`:\nusername: teamboard_admin | password: adminpass123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Register - Success (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const data = pm.response.json();",
              "pm.test(\"Response contains username\", function () {",
              "    pm.expect(data.username).to.eql(\"acmecorp\");",
              "});",
              "pm.test(\"Response contains company_name\", function () {",
              "    pm.expect(data.company_name).to.eql(\"Acme Corp\");",
              "});",
              "pm.test(\"Auto-generated api_key is returned\", function () {",
              "    pm.expect(data.api_key).to.be.a(\"string\").and.not.empty;",
              "});",
              "pm.test(\"JWT access token is returned\", function () {",
              "    pm.expect(data.access).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register",
            ""
          ]
        },
        "description": "Register a new company. A post_save signal auto-creates the Company profile and its api_key; the response also returns a JWT access token so the company can start calling the API immediately.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\",\n  \"company_name\": \"Acme Corp\",\n  \"email\": \"dev@acmecorp.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
