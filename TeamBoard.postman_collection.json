    {
      "name": "04 - Login - Success (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test(\"JWT access token is returned\", function () {",
              "    pm.expect(data.access).to.be.a(\"string\").and.not.empty;",
              "});",
              "pm.test(\"company_name is returned\", function () {",
              "    pm.expect(data.company_name).to.eql(\"Acme Corp\");",
              "});",
              "pm.test(\"api_key is returned\", function () {",
              "    pm.expect(data.api_key).to.be.a(\"string\").and.not.empty;",
              "});",
              "pm.collectionVariables.set(\"client_token\", data.access);",
              "console.log(\"client_token saved for subsequent requests\");"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login",
            ""
          ]
        },
        "description": "Login with valid credentials. The returned access token is saved as the collection variable `client_token` and reused by the protected KB query requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
