    {
      "name": "06 - KB Query - No Token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"Authentication error is returned\", function () {",
              "    pm.expect(pm.response.json().detail).to.include(\"credentials\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/kb/query/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "kb",
            "query",
            ""
          ]
        },
        "description": "Calling the protected KB query endpoint without an Authorization header must return 401 (global JWT protection via DRF defaults).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"search\": \"select_related\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "07 - KB Query - With Token, Results Found (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test(\"Search term is echoed back\", function () {",
              "    pm.expect(data.search).to.eql(\"select_related\");",
              "});",
              "pm.test(\"At least one result is found\", function () {",
              "    pm.expect(data.count).to.be.at.least(1);",
              "});",
              "pm.test(\"results length matches count\", function () {",
              "    pm.expect(data.results.length).to.eql(data.count);",
              "});",
              "pm.test(\"Each result has id, question, answer and category\", function () {",
              "    data.results.forEach(function (r) {",
              "        pm.expect(r).to.have.property(\"id\");",
              "        pm.expect(r).to.have.property(\"question\");",
              "        pm.expect(r).to.have.property(\"answer\");",
              "        pm.expect(r).to.have.property(\"category\");",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{client_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/kb/query/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "kb",
            "query",
            ""
          ]
        },
        "description": "Query the knowledge base with a valid token. Matches question OR answer via icontains and logs the query in QueryLog (inside transaction.atomic()).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"search\": \"select_related\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "08 - KB Query - No Matching Results (200, count 0)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 (not 404)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test(\"count is 0\", function () {",
              "    pm.expect(data.count).to.eql(0);",
              "});",
              "pm.test(\"results is an empty list\", function () {",
              "    pm.expect(data.results).to.be.an(\"array\").that.is.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{client_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/kb/query/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "kb",
            "query",
            ""
          ]
        },
        "description": "A query with no matches must return 200 with an empty results list and count 0 - and the QueryLog is still written because usage-based billing counts queries made, not answers found.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"search\": \"zzz-no-such-topic-anywhere\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
